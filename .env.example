OPENAI_API_KEY=

# One OAuth client can be used for both accounts. Each account needs its own refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
BLOGGER_EN_REFRESH_TOKEN=
BLOGGER_TH_REFRESH_TOKEN=

# Filled automatically by GitHub Actions. For local tests, use owner/repository.
GITHUB_REPOSITORY=
GITHUB_REF_NAME=main

# Safety defaults. Keep true until the first dry run has been reviewed.
DRY_RUN=true
AUTOMATION_ENABLED=false

